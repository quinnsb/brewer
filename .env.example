# Copy to .env for local development. Set the same names in the Vercel project
# settings for production. .env is gitignored and must stay that way.

# The admin password. Make it long and random: serverless cannot rate-limit
# reliably without adding a store, so length is what is actually protecting you.
ADMIN_PASSWORD=

# Signs the session cookie. Rotating this logs you out everywhere.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Fine-grained personal access token, contents read/write, this repo only.
GITHUB_TOKEN=
GITHUB_REPO=quinnsb/brewer
GITHUB_BRANCH=main

# TMDB, for film posters and trailers. Free personal key from
# themoviedb.org/settings/api. Only tools/library-covers.mjs and
# tools/library-trailers.mjs read it; nothing at runtime needs it.
TMDB_API_KEY=
